{
  "name": "tricot",
  "version": "0.0.4",
  "description": "A shared board of canvases, threads and files where humans and agents work together, over MCP",
  "releaseNotes": "A board now opens on Home: your conversation with its coordinator, the work it sends on drawn as strands of yarn with their times, and Work beside it. Questions and finished work come to you there, and what an agent makes shows as a preview under its reply.",
  "license": "Apache-2.0",
  "author": "Tricot Studio",
  "homepage": "https://tricotstudio.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TricotStudio/tricot.git"
  },
  "bugs": "https://github.com/TricotStudio/tricot/issues",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "planning",
    "canvas",
    "whiteboard",
    "collaboration"
  ],
  "bin": {
    "tricot": "dist/cli/tricot.js"
  },
  "files": [
    "dist/cli",
    "dist/web",
    "dist/canvas",
    "hooks",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "dev": "tsx watch src/server/index.ts --dev",
    "build": "node scripts/build.mjs",
    "build:web": "vite build",
    "build:canvas": "vite build --mode canvas",
    "build:cli": "node scripts/build-cli.mjs",
    "prepack": "npm run build",
    "start": "tsx src/server/index.ts",
    "canvas": "tsx src/server/canvas.ts",
    "canvas:dev": "tsx watch src/server/canvas.ts --dev",
    "tricot": "tsx src/cli/tricot.ts",
    "typecheck": "tsc --noEmit",
    "smoke:release": "node scripts/smoke-release.mjs",
    "brand": "node scripts/brand-assets.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/headless": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  }
}
